# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On external hosting (Render/Railway/Fly), set this in your environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
APP_URL="MY_APP_URL"

# SUPABASE DATABASE & AUTHENTICATION (Server-Side + Client-Side)
# Copy the service_role and anon keys from Supabase Project -> Settings -> API
SUPABASE_PROJECT_ID=jooiokndmpquplkwercu
SUPABASE_URL=https://jooiokndmpquplkwercu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://jooiokndmpquplkwercu.supabase.co
VITE_SUPABASE_ANON_KEY=

# GOOGLE MAPS PLATFORM (Optional public browser key for interactive maps)
VITE_GOOGLE_MAPS_API_KEY=

# ADMIN_PASSCODE: Optional server-side passcode overriding the claimed Super Admin password for agrilinkzm0@gmail.com.
ADMIN_PASSCODE=

# BREVO_API_KEY: Brevo Transactional Email API v3 key for verification and staff credential emails.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=agrilinkzm0@gmail.com
BREVO_SENDER_NAME="AgriLink ZM"
